@using Photino.Blazor
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject PhotinoBlazorApp App

@* A VM's screen through noVNC. Connects whenever Url is set, reconnects with backoff if the
   connection drops while the VM is still running, and follows Url when the VM restarts on a new port. *@

<div class="vm-console" @ref="_root">
    <div class="vm-console__toolbar-area">
        @Toolbar
    </div>
    <div class="vm-console__screen-area">
        <div class="vm-console__screen" @ref="_screen"></div>
        @if (_state != ConsoleState.Connected)
        {
            <div class="vm-console__overlay">
                @if (Url is null)
                {
                    @Placeholder
                }
                else if (_state == ConsoleState.Failed)
                {
                    <CbIcon Icon="desktop_access_disabled" Size="Size.Large" />
                    <CbText Typo="Typo.Body1">@(_error ?? "Couldn't connect to the VM's display.")</CbText>
                    <CbButton Variant="Variant.Outlined" StartIcon="refresh" OnClick="_RetryAsync">Try again</CbButton>
                }
                else
                {
                    <CbProgressCircular Indeterminate="true" />
                    <CbText Typo="Typo.Body2" Muted="true">@(_state == ConsoleState.Reconnecting ? "Reconnecting…" : "Connecting…")</CbText>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>VNC websocket of the running VM, or null when it isn't running.</summary>
    [Parameter]
    public string? Url { get; set; }

    [Parameter]
    public ConsoleScale Scale { get; set; } = ConsoleScale.Fit;

    /// <summary>Shown above the screen; in fullscreen it floats over it and hides when not in use.</summary>
    [Parameter]
    public RenderFragment? Toolbar { get; set; }

    /// <summary>Shown over the screen while there is no Url (the VM is off).</summary>
    [Parameter]
    public RenderFragment? Placeholder { get; set; }

    [Parameter]
    public EventCallback<bool> FullscreenChanged { get; set; }

    /// <summary>Delays before each reconnection attempt; after the last one the console gives up.</summary>
    private static readonly TimeSpan[] RetryDelays = [.. new[] { 0.5, 1, 2, 4, 4, 4 }.Select(TimeSpan.FromSeconds)];

    private ElementReference _root;
    private ElementReference _screen;
    private IJSObjectReference? _module;
    private DotNetObjectReference<VmConsole>? _self;
    private ConsoleState _state = ConsoleState.Idle;
    private string? _connectedUrl;
    private ConsoleScale _appliedScale;
    private int _attempt;
    private string? _error;
    private CancellationTokenSource? _retry;
    private bool _disposed;

    private enum ConsoleState
    {
        Idle,
        Connecting,
        Connected,
        Reconnecting,
        Failed,
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/vm-console.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("watchFullscreen", _root, _self);
            _appliedScale = Scale;
        }

        if (Url != _connectedUrl)
        {
            _connectedUrl = Url;
            _attempt = 0;
            _error = null;
            await _ConnectAsync(ConsoleState.Connecting);
        }
        else if (Scale != _appliedScale && _module is not null)
        {
            _appliedScale = Scale;
            await _module.InvokeVoidAsync("setScale", _screen, _ScaleName);
        }
    }

    private string _ScaleName => Scale == ConsoleScale.Fit ? "fit" : "actual";

    private async Task _ConnectAsync(ConsoleState state)
    {
        _CancelRetry();
        if (_module is null || _disposed)
            return;

        if (Url is null)
        {
            await _module.InvokeVoidAsync("disconnect", _screen);
            _SetState(ConsoleState.Idle);
            return;
        }

        _SetState(state);
        await _module.InvokeVoidAsync("connect", _screen, Url, _ScaleName, _self);
    }

    private async Task _RetryAsync()
    {
        _attempt = 0;
        _error = null;
        await _ConnectAsync(ConsoleState.Connecting);
    }

    [JSInvokable]
    public Task OnConnected()
    {
        _attempt = 0;
        _error = null;
        _SetState(ConsoleState.Connected);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnDisconnected(bool clean)
    {
        // Nothing to do if the VM went away (Url cleared) or we were torn down.
        if (_disposed || Url is null)
            return Task.CompletedTask;

        if (_attempt >= RetryDelays.Length)
        {
            _SetState(ConsoleState.Failed);
            return Task.CompletedTask;
        }

        var delay = RetryDelays[_attempt++];
        _SetState(ConsoleState.Reconnecting);
        _retry = new CancellationTokenSource();
        var token = _retry.Token;
        var url = Url;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(delay, token);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            // A new Url (VM restarted) is picked up by OnAfterRenderAsync instead.
            if (Url == url)
                await _ConnectAsync(ConsoleState.Reconnecting);
        });
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnError(string message)
    {
        _error = message;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnDesktopName(string name) => Task.CompletedTask;

    [JSInvokable]
    public Task OnFullscreenChanged(bool fullscreen) => FullscreenChanged.InvokeAsync(fullscreen);

    public async Task SendCtrlAltDelAsync()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("sendCtrlAltDel", _screen);
    }

    public async Task SendKeysAsync(KeyCombo combo)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("sendKeys", _screen, combo.Keys.Select(k => new object[] { k.Keysym, k.Code }).ToArray());
    }

    public async Task ToggleFullscreenAsync()
    {
        if (_module is null)
            return;

        if (OperatingSystem.IsWindows())
            await _SetWindowFullscreenAsync(!Win32Fullscreen.IsFullscreen);
        else
            await _module.InvokeAsync<bool>("toggleFullscreen", _root);
    }

    private async Task _SetWindowFullscreenAsync(bool fullscreen)
    {
        await _module!.InvokeVoidAsync("fillWindow", _root, _screen, fullscreen);
        _SetNativeFullscreen(fullscreen);
        await FullscreenChanged.InvokeAsync(fullscreen);
    }

    private void _SetNativeFullscreen(bool fullscreen)
    {
        var window = App.MainWindow;
        window.Invoke(() =>
        {
            if (fullscreen)
                Win32Fullscreen.Enter(window.WindowHandle);
            else
                Win32Fullscreen.Exit(window.WindowHandle);
        });
    }

    public async Task FocusAsync()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("focus", _screen);
    }

    private void _SetState(ConsoleState state)
    {
        _state = state;
        StateHasChanged();
    }

    private void _CancelRetry()
    {
        _retry?.Cancel();
        _retry?.Dispose();
        _retry = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _CancelRetry();

        // Leaving the console (e.g. its back button) takes the window out of fullscreen with it.
        if (OperatingSystem.IsWindows() && Win32Fullscreen.IsFullscreen)
            _SetNativeFullscreen(false);

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unwatchFullscreen", _root);
                await _module.InvokeVoidAsync("disconnect", _screen);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The window is closing; there's nothing left to disconnect from.
            }
        }

        _self?.Dispose();
    }
}
